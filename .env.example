# Copy to .env.local. All values are optional and server-side only (never exposed to the browser).
# Production URLs must use https://.

# Official currency-rate source. Defaults to the existing bmibaku.az rates endpoint
# (WordPress plugin "currency-rate-manager", admin-ajax.php?action=mv_cr_read).
RATES_SOURCE_URL=https://bmibaku.az/wp-admin/admin-ajax.php

# Where validated credit applications are forwarded (POST, JSON).
# Empty = online applications are not accepted; the page says so and shows phone/email.
# Requires legal, data-protection and security approval before enabling (the form collects FİN).
CREDIT_APPLICATION_ENDPOINT=
CREDIT_APPLICATION_TOKEN=

# Where validated contact / complaint messages are forwarded (POST, JSON).
# Empty = the form is not accepted; the page shows bank@bmibaku.az and phone numbers.
CONTACT_ENDPOINT=
CONTACT_TOKEN=

# Public site origin, used for canonical URLs, sitemap and Open Graph.
SITE_URL=https://bmibaku.az
