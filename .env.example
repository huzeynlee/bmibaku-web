# Copy to .env.local and fill in. All values are optional.
# Leave a value empty to keep the matching widget in its honest fallback state.
# Production URLs must use https:// (relative paths such as /api/... are also accepted).

# POST endpoint for online loan applications.
# Empty = demo mode: the form validates input but sends nothing and says so.
VITE_LOAN_APPLICATION_API_URL=

# GET endpoint returning the current exchange rates (see docs/melumat-ve-inteqrasiya.md).
# Empty = the dated snapshot in src/data/currencies.ts is shown, labelled as not live.
VITE_RATES_API_URL=

# GET endpoint returning historical rates: ?currency=USD&from=YYYY-MM-DD&to=YYYY-MM-DD
# Empty = the history drawer shows an "unavailable" state and links to the official history page.
VITE_RATES_HISTORY_API_URL=
