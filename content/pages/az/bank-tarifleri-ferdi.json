    ],
    [
     {
      "html": "22"
     },
     {
      "html": "Valyuta növündən asılı olmayaraq müxbir hesabın açılması üçün x/h"
     },
     {
      "html": "pulsuzdur"
     }
    ],
    [
     {
      "html": "23"
     },
     {
      "html": "Müxbir bankın hesabına nağd şəkildə daxil olmuş vəsaitdən artıq çıxarılan məbləğindən tutulan komissyon haqqı"
     },
     {
      "html": "razılaşma yolu ilə"
     }
    ],
    [
     {
      "html": "24"
     },
     {
      "html": "Müxbir bankın tapşırığı ilə bankdaxili köçürmələrə görə x/h"
     },
     {
      "html": "pulsuzdur"
     }
    ],
    [
     {
      "html": "25"
     },
     {
      "html": "Müxbir bankın tapşırığı ilə digər banklardakı öz müxbir hesablarına köçürmələrə görə x/h"
     },
     {
      "html": "30 p.v."
     }
    ],
    [
     {
      "html": "26"
     },
     {
      "html": "Xarici banklardan Azərbaycan Respublikasının banklarına, müştərilərinə və əks istiqamətdə köçürülən tranzit pul köçürmələrinə görə x/h"
     },
     {
      "html": "0.5% +dig.bank x/h (min. 10 – max.1000) ABŞ dolları"
     }
    ],
    [
     {
      "html": "27"
     },
     {
      "html": "Müxbir bankların bankdaxili qeyri-nağd mübadilə əməliyyatları üzrə komissiyon haqqı"
     },
     {
      "html": "Əməliyyat tarixinə olan razılaşma məzənnəsinə uyğun"
     }
    ],
    [
     {
      "html": "28"
     },
     {
      "html": "Nağd pul vəsaitlərinin inkassasiyası"
     },
     {
      "html": "Danışıq yolu ilə razılaşmaya əsasən"
     }
    ],
    [
