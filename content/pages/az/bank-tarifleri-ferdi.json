   "rows": [
    [
     {
      "html": "<strong>HESABIN AÇILMASI</strong>",
      "colspan": 3
     }
    ],
    [
     {
      "html": "1"
     },
     {
      "html": "Valyuta növündən asılı olmayaraq bütün cari hesabların açılmasına görə tutulan x/h"
     },
     {
      "html": "10 pul vahidi"
     }
    ],
    [
     {
      "html": "2"
     },
     {
      "html": "Valyuta növündən asılı olmayaraq depozit və digər hesabların açılması"
     },
     {
      "html": "pulsuzdur"
     }
    ],
    [
     {
      "html": "<strong>HESABA VƏSAİTİN DAXİL OLMASI</strong>",
      "colspan": 3
     }
    ],
    [
     {
      "html": "1"
     },
     {
      "html": "Valyuta növündən və mənbəyindən asılı olmayaraq hesaba vəsaitlərin daxil edilməsi üçün x/h"
     },
     {
      "html": "pulsuzdur"
     }
    ],
    [
     {
      "html": "<strong>HESABDAN VƏSAİTİN KÖÇÜRÜLMƏSİ</strong>",
      "colspan": 3
     }
    ],
    [
     {
      "html": "1"
     },
     {
      "html": "Valyuta növündən asılı olmayaraq bankdaxili köçürmələrə görə x/h"
     },
     {
      "html": "pulsuzdur"
     }
    ],
    [
     {
      "html": "2"
     },
     {
      "html": "Respublika daxilində manat köçürmələrinə görə x/h (müştərilərin sığorta haqların və hesaba qarşı irəli sürülən dövlət büdcəsinə və məcburi dövlət sosial sığorta haqların köçürmələri istisna olmaqla)"
     },
     {
      "html": "0.1 % (min 0,50 azn; max 100 azn)"
     }
    ],
    [
     {
      "html": "3"
     },
     {
      "html": "Respublika daxilində icra olunmuş manat köçürmələrində dəyişikliklərin edilməsi, köçürmənin ləğv edilməsi və araşdırmanın aparılması üçün x/h (müştərinin rəsmi müraciəti əsasında)"
     },
     {
      "html": "0.1 % (min 0,50 azn; max 40 azn)"
     }
    ],
    [
     {
      "html": "4"
     },
     {
      "html": "Resublika daxilində xarici valyutada (xaricdən daxil olmuş) vəsaitlərin köçürməsinə görə x/h"
     },
     {
      "html": "razılaşma yolu ilə"
     }
    ],
    [
     {
      "html": "5"
     },
     {
      "html": "Respublika daxilində xarici valyutada (digər hallarda daxil olmuş) vəsaitlərin köçürməsinə görə x/h"
     },
     {
      "html": "0.5% (min 10 p/v max 1000 p/v )"
     }
    ],
    [
     {
      "html": "6"
     },
     {
      "html": "Daxil olmasından asılı olmayaraq respublikadan kənara xarici valyutada köçürmələrə görə x/h"
     },
     {
      "html": "0.5% (min 10 p/v max 1000 p/v )"
     }
    ],
    [
     {
      "html": "7"
     },
     {
      "html": "Respublika daxilində və respublikadan kənara xarici valyutada icra olunmuş köçürmələrdə dəyişikliklərin edilməsi,köçürmənin ləğv edilməsi və araşdırmanın aparılması üçün x/h (müştərinin rəsmi müraciəti əsasında)"
     },
     {
      "html": "10 p/v +vasitəçi bankın x/h-sı"
     }
    ],
    [
     {
      "html": "8"
     },
     {
      "html": "Eyni tarixli, eyni gündə təqdim olunan və tərəfləri eyni olan maksimum xidmət haqqı limitini keçən ödəniş tapşırıöı üzrə x.h"
     },
     {
      "html": "ödən. tapşırıqlarından birində 1000 p.v, qalan ödəniş tapşırıqlarına görə 100 AZN"
     }
    ],
    [
     {
      "html": "<strong>HESABDAN VƏSAİTİN NAĞD ŞƏKİLDƏ ÇIXARILMASI</strong>",
      "colspan": 3
     }
    ],
    [
     {
      "html": "1"
     },
     {
      "html": "Valyuta növündən asılı olmayaraq nağd şəkildə hesaba daxil olunmuş vəsaitlərin nağd şəkildə çıxarılması"
     },
     {
      "html": "pulsuzdur"
     }
    ],
    [
     {
      "html": "2"
     },
     {
      "html": "Köçürmə yolu ilə (o cümlədən bankdaxili) hesaba daxil olunmuş manat vəsaitlərin nağd şəkildə çıxarılması üçün x/h (geri qaytarma təyinatlı köçürmələri istisna olmaqla)"
     },
     {
      "html": "0.5% (min. 2 azn)"
     }
    ],
    [
     {
      "html": "3"
     },
     {
      "html": "Köçürmə yolu ilə hesaba daxil olmuş xarici valyutada vəsaitlərin nağd şəkildə çıxarılması üçün x/h:"
     },
     {
      "html": "razılaşma yolu ilə"
     }
    ],
    [
     {
      "html": "4"
     },
     {
      "html": "Köçürmə yolu ilə ölkə daxilindən hesaba daxil olmuş xarici valyutada vəsaitlərin nağd şəkildə çıxarılması üçün x/h"
     },
     {
      "html": "1% (min. 1 p.v.)"
     }
    ],
    [
     {
      "html": "5"
     },
     {
      "html": "Müştərinin bank hesabı olmadan (ölkə daxilində) xarici valyutada daxil olmuş vəsaitlərinin nağd şəkildə çıxarılması üçün x/h"
     },
     {
      "html": "1% (min. 5 p.v.)"
     }
    ],
    [
     {
      "html": "<strong>MÜBADİLƏ ƏMƏLİYYATLARI</strong>",
      "colspan": 3
     }
    ],
    [
     {
      "html": "13"
     },
     {
      "html": "Bankımızdan alınmış kreditlərlə bağlı köçürmə yolu ilə daxil olan sığorta və digər ödənişlərinin mübadilə əməliyyatları üçün x/h"
     },
     {
      "html": "Əməliyyat tarixinə MB rəsmi məzənnəsinə uyğun"
     }
    ],
    [
     {
      "html": "14"
     },
     {
      "html": "Bütün mübadilə əməliyyatları üçün x/h (bankımızdan alınmış kreditlərlə baglı köçürmə yolu ilə daxil olan sığorta və digər ödənişlərin mübadilə əməliyyatlarından başqa)"
     },
     {
      "html": "Bankın günün qeyri nagd məzənnəsinə uyğun"
     }
    ],
    [
     {
      "html": "<strong>HESABDAN ÇIXARIŞ VƏ HESAB BARƏDƏ ARAYIŞ</strong>",
      "colspan": 3
     }
    ],
    [
     {
      "html": "15"
     },
     {
      "html": "Hesabdan çıxarışın verilməsi üçün x/h"
     },
     {
      "html": "pulsuzdur"
     }
    ],
    [
     {
      "html": "16"
     },
     {
      "html": "Təkrar hesabdan çıxarışın verilməsi üçün x/h (xarici valyuta hesablarından tutulduğu halda MB məzənnəsinə uyğun olaraq)"
     },
     {
      "html": "10 azn"
     }
    ],
    [
     {
      "html": "17"
     },
     {
      "html": "Yazılı məktub, arayış və gömrük idarəsinə təqdim olunan bank əməliyyatı arayışlarına görə x/h (xarici valyuta hesablarından tutulduğu halda MB məzənnəsinə uyğun olaraq)"
     },
     {
      "html": "10 azn"
     }
    ],
    [
     {
      "html": "18"
     },
     {
      "html": "Arxiv məlumatlarına görə x/h (hər bir sənəd üçün) (xarici valyuta hesablarından tutulduğu halda MB məzənnəsinə uyğun olaraq)"
     },
     {
      "html": "10 azn"
     }
    ],
    [
     {
      "html": "<strong>ÇEK KİTABÇALARIN VERİLMƏSİ VƏ HESABIN BAĞLANMASI</strong>",
      "colspan": 3
     }
    ],
    [
     {
      "html": "19"
     },
     {
      "html": "Çek kitabçasının təqdim edilməsi (25 vərəqli)"
     },
     {
      "html": "15 azn"
     }
    ],
    [
     {
      "html": "20"
     },
     {
      "html": "Çek kitabçasının təqdim edilməsi (50 vərəqli)"
     },
     {
      "html": "20 azn"
     }
    ],
    [
     {
      "html": "21"
     },
     {
      "html": "Hesabın bağlanması"
     },
     {
      "html": "pulsuzdur"
     }
    ],
    [
     {
      "html": "<strong>MÜXBİR HESABLAR</strong>",
      "colspan": 3
