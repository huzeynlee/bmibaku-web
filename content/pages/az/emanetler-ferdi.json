 "hiddenContent": [],
 "blocks": [
  {
   "type": "paragraph",
   "html": "“Bank Melli İran” Bakı filialı Respublıkamızda ilk açılan banklardan biridir və 1993-cü ildən bəri Azərbaycan bank bazarında müştərilərə çeşidli xidmət göstərir. Bankımız İran İslam Respublikasının dövlət bankının filialı olaraq bütün maliyyə risklərindən siğortalanıb."
  },
  {
   "type": "paragraph",
   "html": "<strong>Minimal məbləğ 5.000 (AZN)-dan az olmamaq şərtilə vəsaitlər 6 ay müddətinə depozitə yerləşdirilə bilər</strong>."
  },
  {
   "type": "paragraph",
   "html": "<strong>Faizlər hər ay və ya müddətin sonunda götürülə bilər.</strong>"
  },
  {
   "type": "table",
   "rows": [
    [
     {
      "html": "<strong>Müddət</strong>"
     },
     {
      "html": "<strong>% hər ay ödənildiyi halda</strong>"
     },
     {
      "html": "<strong>% müddətin sonunda ödənildiyi halda</strong>"
     }
    ],
    [
     {
      "html": "6 ay"
     },
     {
      "html": "2 %"
     },
     {
      "html": "3 %"
     }
    ]
   ]
  },
  {
   "type": "paragraph",
   "html": "<strong></strong><strong>Depozit vaxtından qabaq götürüldüyü halda heç bir faiz ödənilmir.</strong>"
  },
