 "hiddenContent": [],
 "blocks": [
  {
   "type": "heading",
   "level": 2,
   "text": "Bankın biznes fəlsəfəsi"
  },
  {
   "type": "paragraph",
   "html": "Bankda olduğu kimi filial da öz biznes fəlsəfəsində aşağıdakı dəyərlərə söykənir:"
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    "Etibarlılıq",
    "Təhlükəsizlik",
    "Düzgünlük",
    "Dəqiqlik",
    "Şəffaflıq",
    "Yüksək keyfiyyətli xidmət",
    "Müştəri ilə tərəfdaşlıq",
    "Komandanın üzvlərini «sahibkara» çevirmək",
    "İran-Azərbaycan iqtisadiyyatının inteqrasiyasına xidmət",
    "Azərbaycan qanunlarına riayət və hörmət."
   ]
  },
  {
   "type": "paragraph",
   "html": "Bank bu dəyərləri özünün həm biznes, həm də institusional strategiyasında və gündəlik fəaliyyətində əsas tutur."
  },
  {
   "type": "paragraph",
   "html": "Bankın məqsədi komanda üzvləri və biznes tərəfdaşları ilə daimi əməkdaşlıq qurmaq, onlara özlərinə layiq diqqət göstərməkdir."
  },
  {
   "type": "paragraph",
   "html": "Missiya bəyannaməsi"
  },
  {
   "type": "paragraph",
   "html": "Bank həm filialın işçilərinə, həm də biznes tərəfdaşları olan müştərilərinə aşağıdakı çağırışları edir:"
  },
  {
   "type": "paragraph",
   "html": "İşçi üçün – əlverişli iş şəraiti, motivasiya, işçini inkişaf etdirən bir banka çevrilməklə onların filial ilə uzunmüddətli əlaqələrini davam etdirmək üçün etimadlarını qazanmaq."
  },
  {
   "type": "paragraph",
   "html": "Biznes tərəfdaşı üçün – etibarlı bankda hər bir şəxsə fərdi yanaşma və fərdi yüksək xidmətlə onların etimadını qazanmaq. Xüsusən də İran-Azərbaycan ticarət-iqtsadi əlaqələrinin iştirakçıları üçün birinci seçim bank olmaq."
  }
 ],
