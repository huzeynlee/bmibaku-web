 "blocks": [
  {
   "type": "paragraph",
   "html": "Bankımızın geniş filial şəbəkəsi mövcud olduğundan pul köçürmə xidməti operativ və əlverişli şərtlərlə həyata keçirilir. Ölkədaxili və ölkədənxaric pul köçürmələri üçün tələb olunur:"
  },
  {
   "type": "paragraph",
   "html": "<strong>Azərbaycan vətəndaşları üçün:</strong>"
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    "Şəxsiyyət vəsiqəsi",
    "Pul köçürməsi üçün Ödəniş tapşırığı",
    "Köçürmənin təyinatına dair təsdiqedici sənədlər"
   ]
  },
  {
   "type": "paragraph",
   "html": "<strong>Xarici ölkə vətəndaşları üçün:</strong>"
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    "Passport",
    "Pul köçürməsi üçün Ödəniş tapşırığı",
    "Köçürmənin təyinatına dair təsdiqedici sənədlər"
   ]
  },
  {
   "type": "paragraph",
   "html": "Göstərilmiş xidmətlərə görə komissiya, Bankın İdarə Heyətinin təsdiq etdiyi Tariflər əsasında, əməliyyatın keçirildiyi gün tutulur."
  },
  {
   "type": "paragraph",
   "html": "<strong>1000 ABŞ Dolları ekvivalentindan yuxarı pul vəsaitinin köçürülməsi üçün hesab açılması mütləqdir.</strong>"
  }
 ],
