 "hiddenContent": [],
 "blocks": [
  {
   "type": "paragraph",
   "html": "<strong>Əziz dostlar</strong>,"
  },
  {
   "type": "paragraph",
   "html": "“Bank Melli İran” Bakı filialı “Müştəri xidmətləri” departamentinə əməliyyatçı vakansiyası üzrə yeni əməkdaş axtarışındadır:"
  },
  {
   "type": "paragraph",
   "html": "<strong>Namizədə olan tələblər:</strong>"
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    "Ali iqtisadi təhsil",
    "Vahid komandada işləmək qabiliyyəti;",
    "Ofis proqramlarında sərbəst iş bacarığı",
    "Müştərilərlə və əməkdaşlarla münasibətdə nəzakət nümayiş etmək və ünsiyyət qurmaq qabiliyyəti."
   ]
  },
  {
   "type": "paragraph",
   "html": "<strong>Dil biliyi:</strong>"
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    "Azərbaycan – Yüksək",
    "Fars – Orta",
    "İngilis – Orta"
   ]
  },
  {
   "type": "paragraph",
   "html": "<strong>Biz sizə nə təklif edirik?</strong>"
  },
  {
   "type": "paragraph",
   "html": "-Karyera inkişafı üçün əlverişli mühit;"
  },
  {
   "type": "paragraph",
   "html": "-Bank fəaliyyət sahəsi üzrə təlimlərdə iştirak imkanı;"
  },
  {
   "type": "paragraph",
   "html": "-Komanda quruculuq tədbirlərində iştirak imkanı;"
  },
  {
   "type": "paragraph",
   "html": "-Könüllü tibbi sığorta;"
  },
  {
   "type": "paragraph",
   "html": "-Həyatın yığım sığortasına qoşulmaq imkanı."
  },
  {
   "type": "paragraph",
   "html": "Müraciət etmək istəyən namizədlər <strong>bank@bmibaku.az</strong> elektron ünvanına CV göndərib və ya (+99412)598-90-05 telefon vasitəsilə əlaqə saxlaya bilərlər."
  }
 ],
