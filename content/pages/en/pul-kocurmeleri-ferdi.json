 "blocks": [
  {
   "type": "paragraph",
   "html": "Money transfer service is implemented in a prompt and convenient manner as our bank has wide network of branches. The followings are required for domestic and international money transfers:"
  },
  {
   "type": "paragraph",
   "html": "<strong>For Azerbaijani citizens:</strong>"
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    "Identity card",
    "Payment order for money transfer",
    "Supporting documents for the purpose of transfer"
   ]
  },
  {
   "type": "paragraph",
   "html": "<strong>For foreign nationals:</strong>"
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    "Passport",
    "Payment order for money transfer",
    "Supporting documents for the purpose of transfer"
   ]
  },
  {
   "type": "paragraph",
   "html": "Commission for the rendered services is taken on the date of transaction based on Rates approved by the Bank’s Board of Directors."
  },
  {
   "type": "paragraph",
   "html": "<strong>It is necessary to open account for the transfer of money above the equivalent of 1000 USD.</strong>"
  }
 ],
